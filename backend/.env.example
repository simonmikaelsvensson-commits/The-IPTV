# Example environment variables
PORT=3000
DATABASE_URL=postgresql://dbuser:dbpass@localhost:5432/theiptv

# Mailer (SMTP) settings - set these to your SMTP provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
EMAIL_FROM=no-reply@theiptv.example.com

# JWT secret (change in production)
JWT_SECRET=replace-with-secure-secret

# APP deep link scheme and download URL
APP_DEEP_LINK=theiptv://auth
FRONTEND_DOWNLOAD_URL=https://example.com/download-theiptv

# Optional server public URL used for fallback links
SERVER_URL=http://localhost:3000
